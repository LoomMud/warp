//
// Tier smoke fixture, installed as /builders/appr/box.wf: an apprentice's
// test item. Its program is in a workroom, so it is CONFINED.

inherit /std/item

pub override fn short() -> string {
    return "a practice box"
}

pub override fn ids() -> [string] {
    return ["box"]
}

// OBI-154: called on a clone via call_other, so self() inside this frame
// is the clone itself -- exactly the P0 destruct(self()) case (loom
// OBI-149), not a call to destruct some other object.
pub fn self_destruct() {
    destruct(self())
}
