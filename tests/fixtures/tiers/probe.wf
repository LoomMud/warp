//
// Tier smoke probe (tests/smoke.py `tiers`), installed as
// /builders/appr/probe.wf. When an apprentice first enters it, create()
// tries everything a tier 1 must not do and records what happened; the
// room's description is the report.

inherit /std/room

var report: [string] = []

pub override fn short() -> string {
    return "Probe Room"
}

pub override fn describe() -> string {
    return "Report: " + join(report, " ")
}

fn attempt_write(label: string, path: string) {
    try {
        write_file(path, "probe\n")
        report += [$"{label}:ok"]
    } catch {
        report += [$"{label}:denied"]
    }
}

pub fn noop() {
}

override fn create() {
    attempt_write("write-live", "/domains/start/pwned.txt")
    attempt_write("write-std", "/std/pwned.txt")
    attempt_write("write-other-workroom", "/builders/builder/pwned.txt")
    attempt_write("write-own", "/builders/appr/notes.txt")
    try {
        compile_object("/std/item")
        report += ["compile-std:ok"]
    } catch {
        report += ["compile-std:denied"]
    }
    try {
        read_file("/secure/master.wf")
        report += ["read-secure:ok"]
    } catch {
        report += ["read-secure:denied"]
    }
    try {
        seteuid("aragorn")
        report += ["seteuid:ok"]
    } catch {
        report += ["seteuid:denied"]
    }
    try {
        roles_set_tier("appr", 5, "probe")
        report += ["roles-efun:ok"]
    } catch {
        report += ["roles-efun:denied"]
    }
    // OBI-172: another account's character save is out of reach, for
    // writing and for reading into this object (restore_object is P0, so
    // only the master's can_save stands in the way).
    try {
        save_object("/players/builder")
        report += ["save-other:ok"]
    } catch {
        report += ["save-other:denied"]
    }
    try {
        restore_object("/players/builder")
        report += ["restore-other:ok"]
    } catch {
        report += ["restore-other:denied"]
    }
    try {
        save_object("/builders/appr/probe")
        report += ["save-vfs-path:ok"]
    } catch {
        report += ["save-vfs-path:denied"]
    }
    let why = load_object("/secure/roles").set_tier("appr", 5, "probe") as string
    if why == "" {
        report += ["roles-facade:ok"]
    } else {
        report += ["roles-facade:refused"]
    }
    // OBI-154: destruct(self()) is P0 (loom OBI-149) regardless of tier,
    // but destruct(other) from this frame (self() == probe, not the
    // victim) is still P2 -- a tier 1 apprentice has no `destruct` grant
    // and max_class(1) == 1, so it stays denied.
    let victim1 = clone_object("/builders/appr/box")
    try {
        victim1.self_destruct()
        report += [$"destruct-self:ok:{destructed(victim1)}"]
    } catch {
        report += ["destruct-self:denied"]
    }
    let victim2 = clone_object("/builders/appr/box")
    try {
        destruct(victim2)
        report += ["destruct-other:ok"]
    } catch {
        report += ["destruct-other:denied"]
    }
    if not destructed(victim2) {
        victim2.remove()
    }
    // max_objects (tier 1: 200), charged to the owner: us.
    var made = 0
    try {
        while made < 300 {
            clone_object("/builders/appr/box")
            made += 1
        }
    } catch {
    }
    report += [$"clones:{made}"]
    // max_callouts_obj (tier 1: 8).
    var scheduled = 0
    try {
        while scheduled < 20 {
            call_out("noop", 600)
            scheduled += 1
        }
    } catch {
    }
    report += [$"callouts:{scheduled}"]
}
