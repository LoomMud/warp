// /domains/forest/obj/helmet

inherit /std/armour

pub override fn short() -> string {
    return "a dented helmet"
}

pub override fn ids() -> [string] {
    return ["helmet", "helm"]
}

pub override fn long() -> string {
    return "An iron cap with a large dent in one side."
}

pub override fn slot() -> string {
    return "head"
}
