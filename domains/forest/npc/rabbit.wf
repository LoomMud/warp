// /domains/forest/npc/rabbit

inherit /std/npc

pub override fn short() -> string {
    return "a brown rabbit"
}

pub override fn ids() -> [string] {
    return ["rabbit", "bunny"]
}

pub override fn long() -> string {
    return "A plump brown rabbit, nose twitching."
}

pub override fn npc_level() -> int {
    return 1
}

pub override fn aggressive() -> bool {
    return false
}

pub override fn loadout() -> [string] {
    return []
}

pub override fn max_hp() -> int {
    return 6
}

pub override fn bare_sides() -> int {
    return 2
}

pub override fn in_room() -> string {
    return "A brown rabbit nibbles at the grass."
}
