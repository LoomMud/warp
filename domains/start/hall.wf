// /domains/start/hall

inherit /std/room

pub override fn short() -> string {
    return "The Entrance Hall"
}

pub override fn describe() -> string {
    return "A high-ceilinged hall of pale stone. Morning light spills in through an open archway to the north, and a heavy oak door stands open to the east, onto a forest road. A notice by the door reads: 'Fighting in the hall is forbidden.'"
}

pub override fn exits() -> {string: string} {
    return {"north": "/domains/start/garden", "east": "/domains/forest/edge"}
}

pub override fn spawns() -> {string: int} {
    return {"/domains/start/obj/torch": 1}
}

pub override fn peaceful() -> bool {
    return true
}
