//
// /secure/master: the master object. Boots the world (clock, zones), hands
// each new connection to a /secure/login clone, and binds the connection to
// the player object once login finishes.

// Zones loaded (and so reset) at boot.
pub fn zones() -> [string] {
    return ["/domains/start/zone", "/domains/forest/zone"]
}

fn create() {
    load_object("/secure/combatd")
    for z in zones() {
        load_object(z)
    }
}

// Apply: called by the driver for each new connection. The driver binds the
// connection to the returned object and then calls logon() on it.
fn connect() -> object {
    return clone_object("/secure/login")
}

// True if `ob` is a /secure/login clone.
pub fn is_login(ob: object?) -> bool {
    if ob == null {
        return false
    }
    return split(object_name(ob), "#")[0] == "/secure/login"
}

// Called by /secure/login when a login has finished: move the connection
// from the login object to `player` and bring the player into the world.
// Only the login object that owns the current connection may call this.
pub fn login_complete(login: object, player: object, reconnect: bool) {
    let tp = this_player()
    if tp != login or not is_login(login) {
        return
    }
    if not reconnect {
        load_object("/secure/userd").register(player)
    }
    bind_connection(player)
    player.enter_world(reconnect)
    login.remove()
}

// ---- Security policy applies (loom OBI-35, S1 stack-based check) ----------
// The driver fails closed: with no apply, every P1+ efun (update's
// compile_object, ed's write_file, login's account_*, ...) and every
// read_file is denied for non-root code. Phase 0 policy is allow-all, the
// same as the driver's pre-S1 stub; real tiers (builder/domain/admin) and
// per-path confinement arrive with S2 (loom OBI-36). Results must depend
// only on the arguments (the driver caches them), never on `ob`.

fn valid_efun(name: string, class: int, ob: object) -> bool {
    return true
}

fn valid_compile(path: string, ob: object) -> bool {
    return true
}

fn valid_read(path: string, ob: object, op: string) -> bool {
    return true
}

fn valid_write(path: string, ob: object, op: string) -> bool {
    return true
}

fn valid_bind(ob: object, target: object) -> bool {
    return true
}
