//
// /secure/master: the master object. Boots the world (clock, zones), hands
// each new connection to a /secure/login clone, and binds the connection to
// the player object once login finishes. It also holds the security policy:
// the valid_* applies the driver asks before privileged operations (loom
// docs/security.md), and program_flags for confinement.

// Zones loaded (and so reset) at boot.
pub fn zones() -> [string] {
    return ["/domains/start/zone", "/domains/forest/zone"]
}

fn create() {
    load_object("/secure/combatd")
    for z in zones() {
        load_object(z)
    }
}

// Apply: called by the driver for each new connection. The driver binds the
// connection to the returned object and then calls logon() on it.
fn connect() -> object {
    return clone_object("/secure/login")
}

// True if `ob` is a /secure/login clone.
pub fn is_login(ob: object?) -> bool {
    if ob == null {
        return false
    }
    return split(object_name(ob), "#")[0] == "/secure/login"
}

// Called by /secure/login when a login has finished: move the connection
// from the login object to `player` and bring the player into the world.
// Only the login object that owns the current connection may call this.
pub fn login_complete(login: object, player: object, reconnect: bool) {
    let tp = this_player()
    if tp != login or not is_login(login) {
        return
    }
    if not reconnect {
        load_object("/secure/userd").register(player)
    }
    // The body runs as its account from now on (OBI-36 S2d): the tier
    // checks below key on that euid.
    player.assume_account_euid()
    bind_connection(player)
    player.enter_world(reconnect)
    login.remove()
}

// ---- Security policy (spec r5 §5.11, OBI-36 design note D-S2.5) ----------
//
// The driver asks each apply once for every euid in the guard set (every
// distinct euid on the stack; root never counts) and allows the operation
// only if all of them say yes. Inside an apply, effective_principal() is
// the euid being asked about. Results are cached per (apply, euid,
// argument), so they depend only on those and the roles snapshot, never on
// `ob`. Anything that throws or returns a non-bool is a denial.
//
// Principals:
//   mudlib      /std, /cmds, /daemons, /secure-called code: reviewed and
//               trusted, so it allows what the humans on the same stack
//               are allowed. It never writes /secure or /std live.
//   domain:<d>  area code (rooms, NPCs): P0-P2, reads, no writes/compiles.
//   <account>   a player (tier 0) or staff member (tier 1-5), looked up in
//               the roles snapshot through /secure/roles' read efuns.

// Path classes (§5.11.1). Returns [class, argument].
//   /secure/**                     secure
//   /std, /cmds, /daemons, /include protected
//   /domains/<d>/wip/**             domain_wip(d)
//   /domains/<d>/**  (the rest)     domain_live(d)  [spec: /domains/<d>/live/**;
//                                   Warp's areas predate the live/ split]
//   /builders/<u>/**                workroom(u)
//   /doc/**                         doc
//   /data/**                        data
//   anything else                   other (arch and root only)
pub fn classify(path: string) -> [string] {
    let parts = split(path, "/")
    if len(parts) < 2 or parts[0] != "" or ".." in parts {
        return ["other", ""]
    }
    let top = parts[1]
    if top == "secure" {
        return ["secure", ""]
    }
    if top == "std" or top == "cmds" or top == "daemons" or top == "include" {
        return ["protected", ""]
    }
    if top == "domains" and len(parts) >= 3 and parts[2] != "" {
        if len(parts) >= 4 and parts[3] == "wip" {
            return ["domain_wip", parts[2]]
        }
        return ["domain_live", parts[2]]
    }
    if top == "builders" and len(parts) >= 3 and parts[2] != "" {
        return ["workroom", parts[2]]
    }
    if top == "doc" {
        return ["doc", ""]
    }
    if top == "data" {
        return ["data", ""]
    }
    return ["other", ""]
}

fn roles() -> object {
    return load_object("/secure/roles")
}

pub fn is_domain_uid(who: string) -> bool {
    return split(who, ":")[0] == "domain" and len(split(who, ":")) == 2
}

// A path grant (§5.11.2 "grants") covers the path and everything below it.
fn path_granted(who: string, path: string) -> bool {
    let r = roles()
    let parts = split(path, "/")
    var prefix = ""
    var i = 1
    while i < len(parts) {
        prefix += "/" + parts[i]
        if r.has_grant(who, "path", prefix) as bool {
            return true
        }
        i += 1
    }
    return false
}

// Highest efun privilege class for a tier (§5.11.2 "Efun privilege
// classes"; the seed's tier_policy.efun_classes, which the snapshot does
// not carry yet).
pub fn max_class(tier: int) -> int {
    if tier >= 5 {
        return 4
    }
    if tier == 4 {
        return 3
    }
    if tier == 3 {
        return 2
    }
    if tier >= 1 {
        return 1
    }
    return 0
}

// P2 efuns the ordinary game needs with any account on the stack: `quit`
// disconnects. `destruct` no longer belongs here (OBI-154): the driver now
// treats destruct(self()) as a P0 rule (loom OBI-149, `b6260ba`), so
// remove() -> destruct(self()) (NPC kills, corpses, `dest`) works for any
// tier without an efun grant. Destructing an object other than the
// caller's own self() stays P2, gated by max_class(tier) below (tier 3+)
// or a time-boxed `grant <name> efun destruct ...` for anyone lower.
pub fn account_efuns() -> [string] {
    return ["disconnect"]
}

pub fn can_efun(who: string, name: string, class: int) -> bool {
    if class <= 0 or who == "root" {
        return true
    }
    if who == "mudlib" {
        return class <= 3
    }
    if is_domain_uid(who) {
        return class <= 2
    }
    if name in account_efuns() {
        return true
    }
    if class <= max_class(roles().tier(who) as int) {
        return true
    }
    return roles().has_grant(who, "efun", name) as bool
}

pub fn can_read(who: string, path: string) -> bool {
    if who == "root" or who == "mudlib" {
        return true
    }
    let c = classify(path)
    if is_domain_uid(who) {
        return c[0] != "secure" and c[0] != "data"
    }
    let r = roles()
    let t = r.tier(who) as int
    if t >= 4 {
        return true
    }
    let cls = c[0]
    var ok = false
    if cls == "doc" {
        ok = true
    } else if cls == "protected" {
        ok = t >= 1
    } else if cls == "workroom" {
        ok = t >= 1 and (c[1] == who or t >= 3)
    } else if cls == "domain_live" or cls == "domain_wip" {
        ok = t >= 2 or (t >= 1 and (r.member(who, c[1]) as bool))
    }
    return ok or path_granted(who, path)
}

// Live writes (§5.11.2 "Write, live"; OBI-181 design §3 R2). /secure and
// protected code change only through Git review (`propose` or a PR), never
// live, for every principal and tier: not root, not a T5, not a path grant.
// A T5 writes live only in its own workroom; everything else it proposes.
pub fn can_write(who: string, path: string) -> bool {
    let c = classify(path)
    let cls = c[0]
    if cls == "secure" or cls == "protected" {
        return false
    }
    if who == "root" {
        return true
    }
    if who == "mudlib" {
        return cls == "workroom" or cls == "domain_live" or cls == "domain_wip" or cls == "doc"
    }
    if is_domain_uid(who) {
        return false
    }
    let r = roles()
    let t = r.tier(who) as int
    var ok = false
    if t >= 5 {
        ok = cls == "workroom" and c[1] == who
    } else if t >= 1 {
        if cls == "workroom" {
            ok = c[1] == who
        } else if cls == "domain_wip" {
            ok = (t >= 2 and (r.member(who, c[1]) as bool)) or (r.lead(who, c[1]) as bool) or t >= 4
        } else if cls == "domain_live" {
            ok = (r.lead(who, c[1]) as bool) or t >= 4
        } else if cls == "doc" {
            ok = t >= 3
        }
    }
    return ok or path_granted(who, path)
}

// Review writes (§5.11.2 "Write, via review"; OBI-181 design §3): may `who`
// open a `propose` PR that adds or changes `path` on warp `main`? Anything
// it may write live it may also send to main, plus the review-only cells.
// This only gates who may *open* a PR; approval is CODEOWNERS + branch
// protection on GitHub. Only staff accounts propose: never root, mudlib or
// a domain principal (the driver's own code has no business opening PRs).
//   R1 workrooms are never proposed (they live on live/<env> only).
//   R4 a T1 proposes only into a wip of a domain it is a member of.
pub fn can_propose(who: string, path: string) -> bool {
    if who == "root" or who == "mudlib" or is_domain_uid(who) {
        return false
    }
    let c = classify(path)
    let cls = c[0]
    if cls == "workroom" or cls == "data" or cls == "other" {
        return false
    }
    let r = roles()
    let t = r.tier(who) as int
    if t < 1 {
        return false
    }
    if can_write(who, path) {
        return true
    }
    if cls == "domain_wip" {
        return (r.member(who, c[1]) as bool) or t >= 4
    }
    if cls == "domain_live" {
        return (t >= 2 and (r.member(who, c[1]) as bool)) or t >= 4
    }
    if cls == "doc" {
        return t >= 2
    }
    if cls == "protected" {
        return t >= 3
    }
    if cls == "secure" {
        return t >= 4
    }
    return false
}

// Compiling reloads what is on disk (reviewed code) into the running game.
// T1 only in its own workroom; domains for their members; protected code
// for arches; /secure for roots.
pub fn can_compile(who: string, path: string) -> bool {
    if who == "root" or who == "mudlib" {
        return true
    }
    if is_domain_uid(who) {
        return false
    }
    let c = classify(path)
    let cls = c[0]
    let r = roles()
    let t = r.tier(who) as int
    var ok = false
    if t == 1 {
        ok = cls == "workroom" and c[1] == who
    } else if t >= 2 {
        if cls == "secure" {
            ok = t >= 5
        } else if cls == "workroom" {
            ok = c[1] == who or t >= 3
        } else if cls == "domain_live" or cls == "domain_wip" {
            ok = (r.member(who, c[1]) as bool) or t >= 4
        } else {
            ok = t >= 4
        }
    }
    return ok or path_granted(who, path)
}

// upgrade_all (P1): like compile, but a domain lead only for its own
// domains (§5.11.2) and members never.
pub fn can_upgrade(who: string, path: string) -> bool {
    if who == "root" or who == "mudlib" {
        return true
    }
    if is_domain_uid(who) {
        return false
    }
    let c = classify(path)
    let r = roles()
    let t = r.tier(who) as int
    if c[0] == "domain_live" or c[0] == "domain_wip" {
        return (t >= 3 and (r.lead(who, c[1]) as bool)) or t >= 4
    }
    if c[0] == "workroom" {
        return t >= 1 and c[1] == who
    }
    return can_compile(who, path)
}

// Names that must never become an account uid, because they either name a
// trusted principal (`root`, `mudlib`), a role that implies one (`admin`),
// or a path-class keyword that a `valid_*` apply or /secure code could
// mistake for something else (`builders`, `domain`). This is defence in
// depth (D-S3.1, OBI-155): the driver itself refuses seteuid onto
// root/mudlib/`*:*` regardless of what the mudlib says, but an account
// named one of these should never exist in the first place.
pub fn reserved_account_names() -> [string] {
    return ["root", "mudlib", "admin", "builders", "domain"]
}

// An account uid as created by /secure/login: 3-16 letters a-z, and not one
// of reserved_account_names() (OBI-155).
pub fn is_account_name(n: string) -> bool {
    if len(n) < 3 or len(n) > 16 {
        return false
    }
    let letters = "abcdefghijklmnopqrstuvwxyz"
    var i = 0
    while i < len(n) {
        if not (n[i] in letters) {
            return false
        }
        i += 1
    }
    if n in reserved_account_names() {
        return false
    }
    return true
}

fn valid_efun(name: string, class: int, ob: object) -> bool {
    return can_efun(effective_principal(), name, class)
}

fn valid_read(path: string, ob: object, op: string) -> bool {
    return can_read(effective_principal(), path)
}

fn valid_write(path: string, ob: object, op: string) -> bool {
    return can_write(effective_principal(), path)
}

// Asked by the driver's `git_propose` (OBI-181 B3.3) once per *target*
// path of a proposal, after valid_read on every source path.
fn valid_propose(path: string, ob: object) -> bool {
    return can_propose(effective_principal(), path)
}

fn valid_compile(path: string, ob: object) -> bool {
    return can_compile(effective_principal(), path)
}

fn valid_upgrade(path: string, ob: object) -> bool {
    return can_upgrade(effective_principal(), path)
}

// Only /std/player.assume_account_euid, reached from login_complete with
// root and mudlib alone on the stack, moves an euid, and only onto an
// account name. Anyone else on the stack (any account, any domain) denies.
fn valid_seteuid(ob: object, e: string) -> bool {
    return effective_principal() == "mudlib" and is_account_name(e)
}

// bind_connection is the master's alone and runs with root only on the
// stack, which the driver allows without asking. Deny everyone else.
fn valid_bind(ob: object, target: object) -> bool {
    return false
}

// Apply (cached per program): confinement bits for move_to.
//   1 CONFINED  workroom or domain wip: never enters a live room, never
//               reaches a player's inventory, players never enter it.
//   2 LIVE      domain live content.
fn program_flags(path: string) -> int {
    let cls = classify(path)[0]
    if cls == "workroom" or cls == "domain_wip" {
        return 1
    }
    if cls == "domain_live" {
        return 2
    }
    return 0
}
