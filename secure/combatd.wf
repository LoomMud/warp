//
// /secure/combatd: the mudlib's combat clock, i.e. the Diku "violence
// pulse". It is the only object with a heartbeat. The driver calls
// heartbeat() every 2 s (every 20 world ticks, OBI-82), and each heartbeat
// is one pulse: the clock advances and every enlisted fighter gets one
// combat round, in enlistment order. A fighter whose round throws is
// dropped from the round list and the error does not affect the others.

var clock: int = 0
var fighters: [object] = []
var rounds: int = 0

fn create() {
    // Registration, not static content: the subscription survives upgrades.
    // loom:allow(literal-setter-in-create)
    set_heartbeat(true)
}

fn heartbeat() {
    clock += 1
    run_round()
}

// Pulses (2 s each) since boot. Hit point regeneration is measured in these.
pub fn now() -> int {
    return clock
}

pub fn enlist(ob: object) {
    if not (ob in fighters) {
        fighters += [ob]
    }
}

pub fn fighter_count() -> int {
    return len(fighters)
}

pub fn query_rounds() -> int {
    return rounds
}

// One round. Public so tests and builders can force a round.
pub fn run_round() {
    rounds += 1
    var still: [object] = []
    for f in fighters {
        var keep = false
        try {
            if not destructed(f) {
                keep = f.combat_round() as bool
            }
        } catch e {
            keep = false
        }
        if keep {
            still += [f]
        }
    }
    // Fighters enlisted during this round were appended to `fighters`.
    for f in fighters {
        if not destructed(f) and not (f in still) and f.query_fighting() != null {
            still += [f]
        }
    }
    fighters = still
}
