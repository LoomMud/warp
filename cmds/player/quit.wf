// quit

inherit /std/command

pub override fn help() -> string {
    return "quit: leave the game. Your character stays behind, link-dead, until you log back in."
}

pub override fn main(me: object, args: string) -> bool {
    me.message("Goodbye.")
    disconnect(me)
    return true
}
