// emote <action>

inherit /std/command

pub override fn help() -> string {
    return "emote <action>: act out something (emote smiles -> Aragorn smiles)."
}

pub override fn main(me: object, args: string) -> bool {
    if args == "" {
        me.message("Emote what?")
        return true
    }
    let text = $"{me.cap_name()} {args}"
    me.message(text)
    environment(me)?.tell(text, me)
    return true
}
