//
// ed <path>: staff command. Opens /std/editor on a .wf or .txt file.
// Where you may write is /secure/master's live-write policy (spec r5
// §5.11.2): your own workroom, domain wip/live by membership and tier, and
// never /secure or protected code (those change through Git review). The
// driver asks the master again on every write_file.

inherit /std/command

pub override fn help() -> string {
    return "ed <path>: edit a file (.wf or .txt) line by line. h inside the editor lists commands. Then `update <path>`."
}

pub fn may_edit(me: object, path: string) -> bool {
    return load_object("/secure/master").can_write(me.query_name(), path) as bool
}

pub override fn main(me: object, args: string) -> bool {
    var path = trim(args)
    if path == "" {
        me.message("Edit what? (ed /domains/<area>/<file>.wf)")
        return true
    }
    if path[0] != "/" {
        path = "/" + path
    }
    let n = len(path)
    let is_wf = n > 3 and path[n - 3] == "." and path[n - 2] == "w" and path[n - 1] == "f"
    let is_txt = n > 4 and path[n - 4] == "." and path[n - 3] == "t" and path[n - 2] == "x" and path[n - 1] == "t"
    if not is_wf and not is_txt {
        path += ".wf"
    }
    if not may_edit(me, path) {
        me.message($"You may not edit {path}.")
        return true
    }
    let ed = clone_object("/std/editor")
    let status = ed.start(me, path) as string
    if not (me.start_editor(ed) as bool) {
        ed.remove()
        me.message("You are already editing something.")
        return true
    }
    me.message(status)
    return true
}
