//
// member <domain> <name> <member|lead|none> <reason>: staff command.
// Domain leads manage members of their own domains; arches appoint leads.

inherit /std/command

pub override fn help() -> string {
    return "member <domain> <name> <member|lead|none> <reason>: set domain membership."
}

pub override fn main(me: object, args: string) -> bool {
    let ws = words(args)
    if len(ws) < 4 {
        me.message(help())
        return true
    }
    let d = lower(ws[0])
    let who = lower(ws[1])
    let role = lower(ws[2])
    let err = load_object("/secure/roles").set_member(d, who, role, join_from(ws, 3)) as string
    if err != "" {
        me.message($"Refused: {err}.")
    } else {
        me.message($"Request to make {capitalize(who)} {role} of {d} sent.")
    }
    return true
}
