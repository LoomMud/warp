//
// /std/room: base room. Rooms override short(), describe(), exits() and
// spawns(). These are functions, not variables set in create(), so `update`
// of a room changes its text, exits and reset list immediately (D-P1.4:
// create() is not re-run on reload).
//
// Resets are Diku-style and driven by the room's zone (/std/zone): every
// zone lifespan, reset() tops each spawns() entry back up to its count.

inherit /std/object

// Objects this room spawned and still owns, keyed by spawn path. Mutable
// per-instance state, so it lives in a variable.
var spawned: {string: [object]} = {:}

// ---- static content (override) -----------------------------------------

pub override fn short() -> string {
    return "A featureless room"
}

pub fn describe() -> string {
    return "Nothing to see here."
}

// Direction -> destination room path.
pub fn exits() -> {string: string} {
    return {:}
}

// Reset list: program path -> how many should be here after a reset.
pub fn spawns() -> {string: int} {
    return {:}
}

// Whether combat is allowed here.
pub fn peaceful() -> bool {
    return false
}

// ---- queries ----------------------------------------------------------

pub fn exit_dest(dir: string) -> string? {
    let ex = exits()
    if dir in ex {
        return ex[dir]
    }
    return null
}

pub override fn long() -> string {
    let dirs = keys(exits())
    var text = $"{short()}\n{describe()}"
    if len(dirs) == 0 {
        text += "\nThere are no obvious exits."
    } else {
        text += $"\nObvious exits: {join(dirs, ", ")}."
    }
    return text
}

// Everything `viewer` sees on `look`: description plus contents.
pub fn look_text(viewer: object) -> string {
    var text = long()
    for ob in inventory(self()) {
        if ob != viewer and ob.visible() {
            text += $"\n{ob.in_room()}"
        }
    }
    return text
}

// First visible object in the room answering to `word` (`2.goblin` picks
// the second one).
pub fn find_here(word: string, exclude: object? = null) -> object? {
    var want = 1
    var key = word
    let parts = split(word, ".")
    if len(parts) == 2 {
        let n = to_int(parts[0])
        if n != null {
            want = n
            key = parts[1]
        }
    }
    var seen = 0
    for ob in inventory(self()) {
        if ob != exclude and ob.visible() and ob.id(key) {
            seen += 1
            if seen == want {
                return ob
            }
        }
    }
    return null
}

// ---- messaging ----------------------------------------------------------

// Send text to everything in the room except `exclude`.
pub fn tell(text: string, exclude: object? = null) {
    for ob in inventory(self()) {
        if ob != exclude {
            send(ob, $"{text}\n")
        }
    }
}

// Send text to everything in the room except the objects in `excluded`.
pub fn tell_except(text: string, excluded: [object]) {
    for ob in inventory(self()) {
        if not (ob in excluded) {
            send(ob, $"{text}\n")
        }
    }
}

// Called after `who` arrives, so that NPCs here can react (aggression).
pub fn arrived(who: object) {
    for ob in inventory(self()) {
        if ob != who and ob.is_living() {
            ob.see_arrival(who)
        }
    }
}

// ---- resets -------------------------------------------------------------

// Top every spawns() entry back up to its count. Objects that were taken
// away, killed or removed no longer count.
pub fn reset() {
    let want = spawns()
    var next: {string: [object]} = {:}
    for path in want {
        var kept: [object] = []
        for ob in spawned[path] ?? [] {
            if not destructed(ob) and environment(ob) == self() {
                kept += [ob]
            }
        }
        let count = want[path] ?? 0
        var n = len(kept)
        while n < count {
            let ob = clone_object(path)
            ob.move(self())
            kept += [ob]
            n += 1
        }
        next[path] = kept
    }
    spawned = next
}

// Number of live spawned objects (tests, `stat`).
pub fn spawned_count() -> int {
    var n = 0
    for path in spawned {
        n += len(spawned[path] ?? [])
    }
    return n
}
