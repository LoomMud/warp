//
// /std/player: the living bound to a player's connection. It parses input
// and dispatches verbs to command objects under /cmds (see /secure/cmdd);
// bare exit names walk. After every command it sends a prompt without a
// trailing newline ("<hp/maxhp> "), which is also the end-of-output marker
// the load bot (loadbot/README.md) waits for.
//
// Persistence (OBI-172, loom save_object/restore_object, OBI-171): the
// `persistent` vars here and in /std/living and /std/object are saved to
// /players/<name> in the driver's save root (not the mudlib tree). The
// driver calls autosave() every 5 minutes while connected and once more on
// every disconnect (quit or net-dead). /secure/login restores a character
// that is not in memory (after a restart) with restore_character(). Object
// references never survive a restart, so location and inventory are saved
// as program paths (saved_room, saved_items) and rebuilt on restore.

inherit /std/living

var connected: bool = false
persistent var class_name: string = "adventurer"
// Where the player was at the last save: a room's program path, "" if none.
persistent var saved_room: string = ""
// Carried items at the last save, one map per item: "path" (program),
// "condition" (int) and "eq" ("wield", "wear" or "").
persistent var saved_items: [{string: any}] = []
// True for a body rebuilt from a save since boot, until it enters the world.
var restored: bool = false
// Active `ed` session (/std/editor clone), if any.
var editor: object? = null
var commands_run: int = 0

// ---- static content (override) -----------------------------------------

pub override fn is_player() -> bool {
    return true
}

pub override fn short() -> string {
    return capitalize(name)
}

pub override fn long() -> string {
    return $"{capitalize(name)} the {class_name}. {health_text()}"
}

pub override fn visible() -> bool {
    return connected
}

// Input shorthands. A function, not a variable, so `update` changes it.
pub fn aliases() -> {string: string} {
    return {
        "l": "look",
        "i": "inventory",
        "inv": "inventory",
        "k": "kill",
        "'": "say",
        "n": "north",
        "s": "south",
        "e": "east",
        "w": "west",
        "u": "up",
        "d": "down",
        "ne": "northeast",
        "nw": "northwest",
        "se": "southeast",
        "sw": "southwest"
    }
}

pub fn start_room() -> string {
    return "/domains/start/hall"
}

pub override fn max_hp() -> int {
    if class_name == "warrior" {
        return 20 + level * 12
    }
    return 15 + level * 8
}

pub override fn base_hitroll() -> int {
    if class_name == "warrior" {
        return 1 + level / 2
    }
    return level / 2
}

pub override fn attacks() -> int {
    if class_name == "warrior" and level >= 5 {
        return 2
    }
    return 1
}

// ---- state ----------------------------------------------------------------

// Staff tier (0 = player), from the roles snapshot through /secure/roles.
// Keyed on this body's euid, which /secure/master sets to the account at
// login (assume_account_euid), so nothing stored here can raise it.
pub fn query_tier() -> int {
    return load_object("/secure/roles").tier(geteuid()) as int
}

// Called by /secure/master.login_complete, during the login's own input,
// before the connection is bound: from now on this body acts as its
// account. The master's valid_seteuid allows this only with mudlib alone
// on the stack and only onto an account name; the check here keeps anyone
// but a login in progress from getting that far.
pub fn assume_account_euid() {
    if not (load_object("/secure/master").is_login(this_player()) as bool) {
        return
    }
    if name == "" or geteuid() == name {
        return
    }
    seteuid(name)
}

// Apply: the answer to a /secure/roles change this player asked for.
fn roles_result(id: int, ok: bool, detail: string) {
    if ok {
        message($"[roles] Request {id} done. {detail}")
    } else {
        message($"[roles] Request {id} refused: {detail}")
    }
    if connected {
        send(self(), editor_prompt())
    }
}

pub fn query_class() -> string {
    return class_name
}

pub fn is_connected() -> bool {
    return connected
}

pub fn query_commands_run() -> int {
    return commands_run
}

// Called once by /secure/login for a brand-new character. A name, once
// set, never changes (it becomes the body's euid at login).
pub fn setup_character(new_name: string, new_class: string) {
    if name != "" {
        return
    }
    name = new_name
    class_name = new_class
    set_hp(max_hp())
}

pub override fn set_name(new_name: string) {
}

fn health_text() -> string {
    let h = query_hp()
    let m = max_hp()
    if h * 10 >= m * 9 {
        return "They look healthy."
    } else if h * 2 >= m {
        return "They have some wounds."
    } else if h * 4 >= m {
        return "They are badly hurt."
    }
    return "They are near death."
}

pub fn prompt() -> string {
    return $"<{query_hp()}/{max_hp()}hp> "
}

pub fn write(text: string) {
    message(text)
}

// Start an `ed` session. Only the `ed` command (acting for this player's
// own input, so this_player() is us) may do this.
pub fn start_editor(ed: object) -> bool {
    if this_player() != self() or editor != null {
        return false
    }
    editor = ed
    return true
}

pub fn editor_prompt() -> string {
    let ed = editor
    if ed != null {
        return ed.prompt() as string
    }
    return prompt()
}

// ---- persistence (OBI-172) --------------------------------------------------

// The character's save path. The master's valid_read/valid_write allow
// save_object/restore_object only on /players/<account>, and an account
// only on its own (secure/master.wf can_save).
pub fn save_path() -> string {
    return $"/players/{name}"
}

// Apply (loom OBI-171): every 5 minutes while connected, and on every
// disconnect (an explicit quit and a dropped link both land here).
fn autosave() {
    save_character()
}

// Write the character to its save file. Not `pub`: only the driver's
// autosave() and this body itself decide when it is saved.
fn save_character() -> bool {
    if name == "" {
        return false
    }
    // Fold regeneration so far into hp: hp_at is not saved.
    if hp >= 0 {
        set_hp(query_hp())
    }
    let env = environment()
    if env != null {
        let room = object_name(env)
        // A clone (a room made with `clone`) cannot be reloaded by path.
        if not ("#" in room) {
            saved_room = room
        }
    }
    var items: [{string: any}] = []
    let w = query_wielded()
    for ob in inventory(self()) {
        var eq = ""
        if ob == w {
            eq = "wield"
        } else if is_equipped(ob) {
            eq = "wear"
        }
        // Only /std/item has a condition; anything else saves as 100.
        var cond = 100
        try {
            cond = ob.query_condition() as int
        } catch e {
            cond = 100
        }
        items += [{"path": split(object_name(ob), "#")[0], "condition": cond, "eq": eq}]
    }
    saved_items = items
    return save_object(save_path())
}

// Called by /secure/login, on a fresh /std/player clone, for an account
// whose character is not in memory (a restart since it last played).
// Returns false, leaving the body blank, if there is no usable save.
pub fn restore_character(who: string) -> bool {
    if not (load_object("/secure/master").is_login(this_player()) as bool) {
        return false
    }
    if name != "" {
        return false
    }
    name = who
    if not restore_object(save_path()) or name != who {
        name = ""
        return false
    }
    // Rebase the regeneration clock on this boot's combatd clock.
    if hp >= 0 {
        set_hp(hp)
    }
    for rec in saved_items {
        restore_item(rec)
    }
    restored = true
    return true
}

// Re-create one saved item in our inventory. Items whose program is gone,
// fails to compile, or may not enter a player's inventory are skipped.
fn restore_item(rec: {string: any}) {
    let path = (rec["path"] ?? "") as string
    if path == "" {
        return
    }
    try {
        let ob = clone_object(path)
        ob.move(self())
        let cond = (rec["condition"] ?? 100) as int
        if cond < 100 {
            ob.wear_down(100 - cond)
        }
        let eq = (rec["eq"] ?? "") as string
        if eq == "wield" {
            wield(ob)
        } else if eq == "wear" {
            wear(ob)
        }
    } catch e {
    }
}

// The room a restored character comes back to: its saved room if that
// still loads (and admits it), else the start room.
fn return_to_saved_room() -> object {
    if saved_room != "" {
        try {
            let room = load_object(saved_room)
            move_to(room)
            return room
        } catch e {
        }
    }
    let start = load_object(start_room())
    move_to(start)
    return start
}

// ---- connection lifecycle (called by /secure/master) ---------------------

// The connection has just been bound to us (new login or reconnect).
pub fn enter_world(reconnected: bool) {
    connected = true
    if reconnected {
        message("You take over your body again.")
        environment()?.tell($"{cap_name()} has reconnected.", self())
    } else if restored {
        restored = false
        message($"Welcome back to Oberfield, {cap_name()} the {class_name}.")
        let room = return_to_saved_room()
        room.tell($"{cap_name()} arrives in a puff of smoke.", self())
    } else {
        message($"Welcome to Oberfield, {cap_name()} the {class_name}.")
        message("Type `help` for a list of commands.")
        let env = environment()
        if env == null {
            let start = load_object(start_room())
            move_to(start)
            start.tell($"{cap_name()} arrives in a puff of smoke.", self())
        } else {
            env.tell($"{cap_name()} returns.", self())
        }
    }
    run_command("look")
    send(self(), prompt())
}

// Apply: the connection has gone away (quit or dropped). The body stays in
// the world, link-dead, until the player logs back in.
fn net_dead() {
    let ed = editor
    if ed != null {
        editor = null
        ed.remove()
    }
    if connected {
        connected = false
        stop_fighting()
        environment()?.tell($"{cap_name()} has lost their link.", self())
    }
}

// ---- input --------------------------------------------------------------

// Apply: one line of input from the connection.
fn process_input(line: string) {
    let ed = editor
    if ed != null {
        if not (ed.input(line) as bool) {
            editor = null
            ed.remove()
            message("Left the editor.")
        }
        if connected {
            if editor != null {
                send(self(), ed.prompt() as string)
            } else {
                send(self(), prompt())
            }
        }
        return
    }
    let input = trim(line)
    if input != "" {
        commands_run += 1
        run_command(input)
    }
    if connected {
        send(self(), editor_prompt())
    }
}

// Parse and run one command line as this player. Deliberately not `pub`:
// only this player's own input can make it act.
fn run_command(input: string) {
    var verb = ""
    var args = ""
    if input[0] == "'" {
        verb = "say"
        args = trim(join_from(split(input, "'"), 1))
    } else {
        let ws = words(input)
        verb = lower(ws[0])
        args = join_from(ws, 1)
    }
    let al = aliases()
    if verb in al {
        verb = al[verb] ?? verb
    }
    let env = environment()
    if env != null and env.exit_dest(verb) != null {
        go_dir(verb)
        run_command("look")
        return
    }
    let path = load_object("/secure/cmdd").find(verb, query_tier())
    if path == null {
        message("What?")
        return
    }
    let cmd = load_object(path as string)
    try {
        cmd.main(self(), args)
    } catch e {
        // Security denials (valid_*, quotas, confinement) end up here.
        message($"{verb}: {e}")
    }
}

// Diku-style: re-send the prompt after every combat round we take part in.
pub override fn combat_round() -> bool {
    let still = super::combat_round()
    if connected {
        send(self(), prompt())
    }
    return still
}

// ---- death --------------------------------------------------------------

pub override fn die(killer: object?) {
    let env = environment()
    stop_fighting()
    message("You have been KILLED!")
    if env != null {
        env.tell($"{cap_name()} is DEAD!", self())
    }
    if killer != null {
        killer.killed(self())
    }
    xp -= xp / 10
    let start = load_object(start_room())
    move_to(start)
    set_hp(max_hp() / 2)
    message("You wake up in the Entrance Hall, shaken but alive.")
    start.tell($"{cap_name()} appears, looking pale.", self())
}

// A player is never worth much to kill.
pub override fn xp_value() -> int {
    return level * 5
}
